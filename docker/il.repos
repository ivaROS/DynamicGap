# Workspace of the imitation-learning (manual gap selection) lab PC, for `vcs import src < il.repos`.
# DynamicGap itself is cloned by the Dockerfile (ivaROS/DynamicGap, branch imitation_learning).
# The four IL repos follow their branch; everything else is pinned to the commit the lab PC builds.
repositories:
  arena/arena-rosnav:
    type: git
    url: https://github.com/Udog-ILLINOIS/arena-rosnav.git
    version: imitation_learning
  arena/evaluation:
    type: git
    url: https://github.com/Udog-ILLINOIS/arena-evaluation.git
    version: imitation_learning
  arena/simulation-setup:
    type: git
    url: https://github.com/Udog-ILLINOIS/arena-simulation-setup.git
    version: imitation_learning
  arena/utils/pedsim_ros:
    type: git
    url: https://github.com/ivaROS/pedsim_ros.git
    version: global_path_custom_ped
  arena/utils/3rd-party-robot-packages:
    type: git
    url: https://github.com/Arena-Rosnav/3rd-party-robot-packages
    version: 8b60c1169626568bf734a07c3b0f13b06d3e2871
  arena/utils/actionlib:
    type: git
    url: https://github.com/ivaROS/actionlib.git
    version: 6710219fbd38c90246543883b06d80e14e7ec7e4
  arena/utils/flatland:
    type: git
    url: https://github.com/ivaROS/flatland.git
    version: 88ef913b931c5492eb8e7bb5f87796760394a1a5
  arena/utils/move_base_flex:
    type: git
    url: https://github.com/Arena-Rosnav/move_base_flex.git
    version: c3613d87e3e7c65d85225feb3f90350023c1361a
  arena/utils/navigation:
    type: git
    url: https://github.com/ivaROS/navigation.git
    version: cf6d1d2a7e5e4cf56e56610299e72d674b2896f9
  arena/utils/stable-baselines3:
