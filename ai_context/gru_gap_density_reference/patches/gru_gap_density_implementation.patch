+                float rawLeftX = 0.0f;
+                float rawLeftY = 0.0f;
+
+                rawGap->getLCartesian(rawLeftX, rawLeftY);
+
+                const float rawLeftRadius =
+                    std::sqrt(
+                        rawLeftX * rawLeftX +
+                        rawLeftY * rawLeftY
