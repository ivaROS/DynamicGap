#!/usr/bin/env python3
"""Copy recorded IL sessions to the shared Google Drive folder, labelled with the operator.

Usage: il_upload_sessions [SESSION_DIR ...] [--remote REMOTE] [--operator NAME] [--dry-run]
  no SESSION_DIR: every session in ~/il_data/il_gap_selection without on_drive.txt
  REMOTE   rclone destination, default $IL_DRIVE_REMOTE (ildrive: = the ilData folder)
  NAME     default $IL_OPERATOR, else the operator in the session's params.yaml
A session lands in REMOTE/sessions/NAME/<session>/. Nothing local is deleted: the bags stay.
Sessions still recording (a .bag.active file) are skipped. run_il_dataset.sh runs this after each run.
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import il_drive  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("sessions", nargs="*")
    parser.add_argument("--remote", default=os.environ.get("IL_DRIVE_REMOTE"))
    parser.add_argument("--operator", default=os.environ.get("IL_OPERATOR"))
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    if not args.remote:
        parser.error("no remote: pass --remote gdrive:IL_data or set IL_DRIVE_REMOTE")
    sessions = args.sessions or il_drive.pending_sessions(os.path.join(il_drive.data_root(), "il_gap_selection"))
    if not sessions:
        print("nothing to upload")
    failed = False
    for s in sessions:
        if not os.path.isdir(s):
            sys.exit("not a directory: {}".format(s))
        failed |= il_drive.upload_session(s, args.remote, args.operator, args.dry_run) < 0
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
