#!/usr/bin/env python3
"""Build the training set from recorded IL sessions (docs/IL_DATA_COLLECTION_PLAN.md, 1.7).

Usage: il_build_dataset --out DIR [options] SESSION_DIR [SESSION_DIR ...]
       il_build_dataset --out DIR --set SET_FILE [options]   (only the episodes the set lists)
Writes DIR/{train,val,test}.jsonl.gz (one example per line) and DIR/dataset.yaml.
"""

import argparse
import math
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import il_dataset  # noqa: E402


def main():
    d = il_dataset.DEFAULTS
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("sessions", nargs="*")
    parser.add_argument("--set", help="episode set file; its episodes are kept even if they collided")
    parser.add_argument("--out", required=True)
    parser.add_argument("--namespace", default=None)
    parser.add_argument("--lag", type=float, default=d["lag_s"], help="reaction lag, wall clock seconds")
    parser.add_argument("--max-cursor-dist", type=float, default=d["max_cursor_dist"])
    parser.add_argument("--max-bearing-diff", type=float, default=d["max_bearing_diff"])
    parser.add_argument("--min-tie-margin", type=float, default=d["min_tie_margin"])
    parser.add_argument("--keep-collision-episodes", action="store_true")
    parser.add_argument("--seed", default=d["seed"])
    args = parser.parse_args()

    selection = il_dataset.load_set(args.set) if args.set else None
    if selection is not None:
        args.sessions = list(selection)
    elif not args.sessions:
        parser.error("give session folders or --set")
    if os.path.exists(args.out) and os.listdir(args.out):
        sys.exit("output folder {} is not empty".format(args.out))

    summary = il_dataset.build_dataset(args.sessions, args.out, {
        "lag_s": args.lag,
        "max_cursor_dist": args.max_cursor_dist,
        "max_bearing_diff": args.max_bearing_diff,
        "min_tie_margin": args.min_tie_margin,
        "drop_collision_episodes": not args.keep_collision_episodes,
        "seed": args.seed,
    }, args.namespace, selection)
    for split, counts in summary["splits"].items():
        print("{}: {} examples from {} episodes".format(split, counts["examples"], counts["episodes"]))
    for session, info in summary["sessions"].items():
        print("{}: {}".format(session, info["counts"]))


if __name__ == "__main__":
    main()
